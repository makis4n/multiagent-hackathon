# Copy to .env (gitignored). Empty values here on purpose: never commit a key.

# Lane A: model
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-flash-lite-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Lane B: research
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="trip-agent/0.1 by your-reddit-username"
YOUTUBE_API_KEY=
EXA_API_KEY=

# Lane C: places, routes, calendar
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# Lane D: booking (test mode only; the client refuses a live key)
DUFFEL_API_KEY=
ORDER_STORE=logs/orders.json
VIATOR_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Flags: 1 selects the lane's real implementation, anything else selects the fake
REAL_RESEARCH=
REAL_PLACES=
REAL_PLANNER=
REAL_VERIFIER=
REAL_BOOKING=
REAL_CALENDAR=

# Demo: 1 makes the first booking order fail after the provider created it, so the retry shows on screen
INJECT_BOOKING_FAILURE=
